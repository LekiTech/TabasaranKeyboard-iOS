      }
    },
    "Every one of them can also be typed key by key: г, then ъ; к, then Ӏ. Doubled letters (кк, чч) and жв, чв, шв are typed as two letters." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every one of them can also be typed key by key: г, then ъ; к, then Ӏ. Doubled letters (кк, чч) and жв, чв, шв are typed as two letters."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любую из них можно набрать и по буквам: г, затем ъ; к, затем Ӏ. Удвоенные буквы (кк, чч) и жв, чв, шв набираются двумя буквами."
          }
        }
      }
    },
    "Feels native" : {
