        }
      }
    },
    "How to install" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to install"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как установить"
          }
        }
      }
    },
    "It is drawn from scanned issues of a Tabasaran magazine and from a Tabasaran–Russian dictionary. Scanning errors were corrected where the evidence was clear, and the dictionary is still being reviewed: suggestions may contain misspellings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is drawn from scanned issues of a Tabasaran magazine and from a Tabasaran–Russian dictionary. Scanning errors were corrected where the evidence was clear, and the dictionary is still being reviewed: suggestions may contain misspellings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он собран по отсканированным номерам табасаранского журнала и по табасаранско-русскому словарю. Ошибки распознавания исправлены там, где это однозначно, и словарь ещё проходит проверку: в подсказках могут встречаться ошибки написания."
          }
        }
      }
    },
